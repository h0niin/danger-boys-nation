# ─── Danger Boys Environment Variables ───────────────────────────────────────
# Copy this to .env.local and fill in your values.
# NEVER commit .env.local to git.

# Supabase project credentials (get these from supabase.com → Project Settings → API)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Shared passcode for all DB members (default: DANGERBOYS25)
VITE_DB_PASSCODE=DANGERBOYS25
